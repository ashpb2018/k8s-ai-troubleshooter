# ─── Backend selection ───────────────────────────────────────────────────────
# One of: ollama | bedrock | openai
LLM_PROVIDER=ollama

# ─── Ollama (local, no API key) ──────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── AWS Bedrock ──────────────────────────────────────────────────────────────
# Auth priority: BEDROCK_API_KEY, then IAM keys, then the default boto3 chain.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── Kubernetes ───────────────────────────────────────────────────────────────
# Leave blank to use ~/.kube/config and the current context.
KUBECONFIG=
K8S_CONTEXT=

# ─── Behaviour ────────────────────────────────────────────────────────────────
# Apply fixes without confirmation prompts (kept as AUTO_FIX for compatibility).
AUTO_FIX=false
RUNBOOK_DIR=./runbooks
MAX_LOG_LINES=200
DEBUG=false
